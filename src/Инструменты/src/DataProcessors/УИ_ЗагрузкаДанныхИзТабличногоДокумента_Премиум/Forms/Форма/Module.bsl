////////////////////////////////////////////////////////////////////////////////
// Обработка: УИ_ЗагрузкаДанныхИзТабличногоДокумента_Премиум
// Модуль управляемой формы
// Платформа: 1С:Предприятие 8.3.18–8.3.27 / 8.5.1+
// Конфигурация: УНФ 3.0.12.199 (совместимо с УТ 11.5 / ERP 2.5)
////////////////////////////////////////////////////////////////////////////////

#Область Переменные

Перем ТекущиеДвоичныеДанные;
Перем ПрогрессОбновление;

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ ФОРМЫ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПриОткрытии(Отказ) Экспорт
	
	// Инициализация переменных
	ТекущиеДвоичныеДанные = Неопределено;
	ПрогрессОбновление = 0;
	
	// Подготовка таблиц формы
	ИнициализироватьТаблицуМаппинга();
	ИнициализироватьТаблицуПредпросмотра();
	ИнициализироватьТаблицуЛогов();
	
	// Установка начальных значений
	Объект.РазмерПакета = 500;
	Объект.РежимЗагрузки = "СоздаватьЕслиНет";
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТаблицуМаппинга()
	
	// Таблица маппинга уже определена в метаданных формы
	// Очищаем и подготавливаем к использованию
	ТаблицаМаппинга.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТаблицуПредпросмотра()
	
	ТаблицаПредпросмотра.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьТаблицуЛогов()
	
	ТаблицаЛогов.Очистить();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// РАБОТА С ФАЙЛОМ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВыбратьФайл(Команда) Экспорт
	
	ДиалогОткрытияФайла = Новый ДиалогОткрытияФайла();
	ДиалогОткрытияФайла.Заголовок = "Выберите файл для загрузки";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Фильтр = 
		"Файлы Excel (*.xlsx;*.xls)|*.xlsx;*.xls|" +
		"Табличные документы (*.mxl)|*.mxl|" +
		"Текстовые файлы (*.txt;*.csv)|*.txt;*.csv|" +
		"Все файлы (*.*)|*.*";
	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		ПутьКФайлу = ДиалогОткрытияФайла.Файлы[0];
		
		// Чтение файла на сервере
		ЧтениеФайла = Новый ЧтениеФайла(ПутьКФайлу);
		ТекущиеДвоичныеДанные = ЧтениеФайла.ПрочитатьДвоичныеДанные();
		ЧтениеФайла.Закрыть();
		
		// Отображение имени файла
		Элементы.ПолеИмяФайла.Заголовок = "Файл: " + ПолучитьИмяФайла(ПутьКФайлу);
		
		// Запуск предпросмотра
		ЗапуститьПредпросмотр();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайла(Знач ПолныйПуть)
	
	Разделители = СтрРазделить(ПолныйПуть, "\/", Ложь, Ложь);
	Возврат Разделители[Разделители.ВГраница()];
	
КонецФункции

&НаСервере
Процедура ЗапуститьПредпросмотр()
	
	Если ТекущиеДвоичныеДанные = Неопределено Тогда
		Сообщить("Файл не выбран", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	// Чтение табличного документа
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ТекущиеДвоичныеДанные);
	
	// Получение заголовков
	Заголовки = Новый Массив;
	Для к = 1 По ТабличныйДокумент.Макет.Ширина Цикл
		Заголовки.Добавить(ТабличныйДокумент.Макет.Область(1, к).Текст);
	КонецЦикла;
	
	// Автоматический маппинг
	ТаблицаМаппингаАвто = УИ_ЗагрузкаДанных_Сервер.АвтоматическийМаппингЗаголовков(Заголовки, Метаданные);
	
	// Копирование в таблицу формы
	ТаблицаМаппинга.Очистить();
	Для Каждого СтрокаАвто Из ТаблицаМаппингаАвто Цикл
		НоваяСтрока = ТаблицаМаппинга.Добавить();
		НоваяСтрока.НомерКолонки = СтрокаАвто.НомерКолонки;
		НоваяСтрока.ИмяРеквизита = СтрокаАвто.ИмяРеквизита;
		НоваяСтрока.Режим = СтрокаАвто.Режим;
		НоваяСтрока.ЭтоКлючПоиска = СтрокаАвто.ЭтоКлючПоиска;
		НоваяСтрока.ЦелевойОбъект = СтрокаАвто.ЦелевойОбъект;
	КонецЦикла;
	
	// Заполнение предпросмотра (первые 10 строк)
	ТаблицаПредпросмотра.Очистить();
	МаксимумСтрок = Мин(ТабличныйДокумент.Макет.Высота - 1, 10);
	
	Для НомерСтроки = 2 По 1 + МаксимумСтрок Цикл
		НоваяСтрока = ТаблицаПредпросмотра.Добавить();
		НоваяСтрока.НомерСтрокиФайла = НомерСтроки;
		
		Для к = 1 По ТабличныйДокумент.Макет.Ширина Цикл
			ЗначениеЯчейки = ТабличныйДокумент.Макет.Область(НомерСтроки, к).Текст;
			// Динамическое добавление колонок в предпросмотр
			ИмяКолонки = "Колонка" + к;
			Если ТаблицаПредпросмотра.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				ТаблицаПредпросмотра.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка"));
			КонецЕсли;
			НоваяСтрока[ИмяКолонки] = ЗначениеЯчейки;
		КонецЦикла;
	КонецЦикла;
	
	Сообщить("Предпросмотр загружен. Строк: " + МаксимумСтрок, СтатусСообщения.Информация);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЗАПУСК ЗАГРУЗКИ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗагрузитьДанные(Команда) Экспорт
	
	Если ТекущиеДвоичныеДанные = Неопределено Тогда
		Сообщить("Выберите файл для загрузки", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Если ТаблицаМаппинга.Количество() = 0 Тогда
		Сообщить("Настройте маппинг колонок", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	// Блокировка интерфейса
	УстановитьБлокировкуИнтерфейса(Истина);
	
	// Запуск загрузки на сервере
	ЗапуститьЗагрузкуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьЗагрузкуНаСервере()
	
	Попытка
		
		// Преобразование таблицы маппинга
		ТаблицаМаппингаДляСервера = Новый ТаблицаЗначений;
		ТаблицаМаппингаДляСервера.Колонки.Добавить("НомерКолонки", Новый ОписаниеТипов("Число"));
		ТаблицаМаппингаДляСервера.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
		ТаблицаМаппингаДляСервера.Колонки.Добавить("Режим", Новый ОписаниеТипов("Строка"));
		ТаблицаМаппингаДляСервера.Колонки.Добавить("ЭтоКлючПоиска", Новый ОписаниеТипов("Булево"));
		ТаблицаМаппингаДляСервера.Колонки.Добавить("ЦелевойОбъект", Новый ОписаниеТипов("Строка"));
		
		Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
			НоваяСтрока = ТаблицаМаппингаДляСервера.Добавить();
			НоваяСтрока.НомерКолонки = СтрокаМаппинга.НомерКолонки;
			НоваяСтрока.ИмяРеквизита = СтрокаМаппинга.ИмяРеквизита;
			НоваяСтрока.Режим = СтрокаМаппинга.Режим;
			НоваяСтрока.ЭтоКлючПоиска = СтрокаМаппинга.ЭтоКлючПоиска;
			НоваяСтрока.ЦелевойОбъект = СтрокаМаппинга.ЦелевойОбъект;
		КонецЦикла;
		
		// Вызов основной функции загрузки
		Результат = УИ_ЗагрузкаДанных_Сервер.ЗагрузитьДанныеИзТабличногоДокумента(
			ТекущиеДвоичныеДанные,
			ТаблицаМаппингаДляСервера,
			Объект.РежимЗагрузки,
			Объект.РазмерПакета
		);
		
		Если Результат <> Неопределено Тогда
			
			// Вывод результатов
			Сообщить(
				"Загрузка завершена!" + Символы.ПС +
				"Всего строк: " + Результат.Всего + Символы.ПС +
				"Успешно: " + Результат.Успешно + Символы.ПС +
				"Ошибки: " + Результат.Ошибки,
				?(Результат.Ошибки > 0, СтатусСообщения.Важное, СтатусСообщения.Информация)
			);
			
			// Заполнение таблицы логов
			ТаблицаЛогов.Очистить();
			Для Каждого СтрокаЛога Из Результат.ЛогиОшибок Цикл
				НоваяСтрока = ТаблицаЛогов.Добавить();
				НоваяСтрока.НомерСтроки = СтрокаЛога.НомерСтроки;
				НоваяСтрока.ТекстОшибки = СтрокаЛога.ТекстОшибки;
				НоваяСтрока.Контекст = СтрокаЛога.Контекст;
			КонецЦикла;
			
		Иначе
			
			Сообщить("Произошла критическая ошибка при загрузке", СтатусСообщения.ОченьВажное);
			
		КонецЕсли;
		
	Исключение
		
		Сообщить("Ошибка: " + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		
	КонецПопытки;
	
	// Разблокировка интерфейса
	УстановитьБлокировкуИнтерфейса(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьБлокировкуИнтерфейса(Знач Блокировка)
	
	Элементы.КнопкаЗагрузить.Доступность = Не Блокировка;
	Элементы.КнопкаВыбратьФайл.Доступность = Не Блокировка;
	Элементы.ГруппаМаппинг.Доступность = Не Блокировка;
	
	Если Блокировка Тогда
		Элементы.ИндикаторПрогресса.Видимость = Истина;
	Иначе
		Элементы.ИндикаторПрогресса.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// БЕНЧМАРК
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ЗапуститьБенчмарк(Команда) Экспорт
	
	Ответ = Вопрос("Запустить тест производительности на 10 000 строк?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		УстановитьБлокировкуИнтерфейса(Истина);
		
		Попытка
			
			РезультатБенчмарка = ЗапуститьБенчмаркНаСервере(10000);
			
			Сообщить(
				"Бенчмарк завершён!" + Символы.ПС +
				"Строк: " + РезультатБенчмарка.КоличествоСтрок + Символы.ПС +
				"Время: " + Формат(РезультатБенчмарка.ВремяСекунд, "ЧГ=2.2") + " сек." + Символы.ПС +
				"Успешно: " + РезультатБенчмарка.Успешно + Символы.ПС +
				"Ошибки: " + РезультатБенчмарка.Ошибки,
				СтатусСообщения.Информация
			);
			
		Исключение
			
			Сообщить("Ошибка бенчмарка: " + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
			
		КонецПопытки;
		
		УстановитьБлокировкуИнтерфейса(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьБенчмаркНаСервере(КоличествоСтрок)
	
	Возврат Объект.ЗапуститьБенчмарк(КоличествоСтрок);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВАЛИДАЦИЯ И ПОДСКАЗКИ
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ТаблицаМаппингаПриИзменении(Элемент) Экспорт
	
	// Валидация изменений в таблице маппинга
	АктивнаяСтрока = ТаблицаМаппинга.ТекущаяСтрока;
	Если АктивнаяСтрока <> Неопределено Тогда
		
		// Проверка уникальности номера колонки
		КоличествоПовторений = 0;
		Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
			Если СтрокаМаппинга.НомерКолонки = АктивнаяСтрока.НомерКолонки Тогда
				КоличествоПовторений = КоличествоПовторений + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличествоПовторений > 1 Тогда
			Сообщить("Номер колонки должен быть уникальным", СтатусСообщения.Внимание);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогресс(Знач Прогресс)
	
	ПрогрессОбновление = Прогресс;
	Элементы.ИндикаторПрогресса.Прогресс = Прогресс;
	
КонецПроцедуры
