КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС ДЛЯ РЕГИСТРАЦИИ ОБРАБОТКИ
////////////////////////////////////////////////////////////////////////////////

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;

	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", НСтр("ru = 'Загрузка данных из табличного документа [Премиум]'"));
	ПараметрыРегистрации.Вставить("Версия", "2.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", НСтр(
		"ru = 'Высокопроизводительная обработка для загрузки данных в справочники и табличные части с поддержкой характеристик номенклатуры. Оптимизирована для работы с большими объёмами данных (до 50k строк).'"
	));

	ТаблицаКоманд = ПолучитьТаблицуКоманд();

	ДобавитьКоманду(ТаблицаКоманд, НСтр("ru = 'Загрузка из табличного документа (Премиум)'"),
		"Открытие_ЗагрузкаДанныхИзТабличногоДокумента_Премиум_2_0",
		"ОткрытиеФормы");

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь,
	Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды) Экспорт
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// БЕНЧМАРК ПРОИЗВОДИТЕЛЬНОСТИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ЗапуститьБенчмарк(КоличествоСтрок = 10000) Экспорт
	
	// Создание тестовых данных
	ТестовыеДанные = Новый ДвоичныеДанные(СоздатьТестовыйФайл(КоличествоСтрок));
	
	// Подготовка маппинга
	ТаблицаМаппинга = Новый ТаблицаЗначений;
	ТаблицаМаппинга.Колонки.Добавить("НомерКолонки", Новый ОписаниеТипов("Число"));
	ТаблицаМаппинга.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	ТаблицаМаппинга.Колонки.Добавить("Режим", Новый ОписаниеТипов("Строка"));
	ТаблицаМаппинга.Колонки.Добавить("ЭтоКлючПоиска", Новый ОписаниеТипов("Булево"));
	ТаблицаМаппинга.Колонки.Добавить("ЦелевойОбъект", Новый ОписаниеТипов("Строка"));
	
	СтрокаМаппинга = ТаблицаМаппинга.Добавить();
	СтрокаМаппинга.НомерКолонки = 1;
	СтрокаМаппинга.ИмяРеквизита = "Код";
	СтрокаМаппинга.Режим = "СоздаватьЕслиНет";
	СтрокаМаппинга.ЭтоКлючПоиска = Истина;
	СтрокаМаппинга.ЦелевойОбъект = "Номенклатура";
	
	СтрокаМаппинга = ТаблицаМаппинга.Добавить();
	СтрокаМаппинга.НомерКолонки = 2;
	СтрокаМаппинга.ИмяРеквизита = "Наименование";
	СтрокаМаппинга.Режим = "СоздаватьЕслиНет";
	СтрокаМаппинга.ЭтоКлючПоиска = Ложь;
	СтрокаМаппинга.ЦелевойОбъект = "Номенклатура";
	
	// Замер времени
	НачалоВремени = ТекущаяДата();
	
	Результат = УИ_ЗагрузкаДанных_Сервер.ЗагрузитьДанныеИзТабличногоДокумента(
		ТестовыеДанные, 
		ТаблицаМаппинга, 
		"СоздаватьЕслиНет", 
		500
	);
	
	КонецВремени = ТекущаяДата();
	ВремяВыполнения = КонецВремени - НачалоВремени;
	
	Возврат Новый Структура(
		"КоличествоСтрок,ВремяСекунд,Успешно,Ошибки",
		КоличествоСтрок,
		ВремяВыполнения,
		Результат.Успешно,
		Результат.Ошибки
	);
	
КонецФункции

&НаСервере
Функция СоздатьТестовыйФайл(КоличествоСтрок)
	
	// Генерация простого CSV-подобного содержимого для теста
	Содержимое = "Код" + Символы.Таб + "Наименование" + Символы.ПС;
	
	Для к = 1 По КоличествоСтрок Цикл
		Содержимое = Содержимое + "TEST" + Формат(к, "ЧГ=") + Символы.Таб + "Товар " + Формат(к, "ЧГ=") + Символы.ПС;
	КонецЦикла;
	
	// Преобразование в поток и затем в двоичные данные
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Содержимое);
	ЗаписьТекста.Закрыть();
	
	Поток.Позиция = 0;
	Возврат Поток.ПрочитатьДвоичныеДанные(Поток.Размер);
	
КонецФункции
