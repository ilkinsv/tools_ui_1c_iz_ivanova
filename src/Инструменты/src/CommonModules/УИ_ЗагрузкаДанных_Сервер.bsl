////////////////////////////////////////////////////////////////////////////////
// Общий модуль: УИ_ЗагрузкаДанных_Сервер
// Назначение: Серверная логика загрузки данных из табличного документа
// Платформа: 1С:Предприятие 8.3.18–8.3.27 / 8.5.1+
// Конфигурация: УНФ 3.0.12.199 (совместимо с УТ 11.5 / ERP 2.5)
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныеПеременные

Перем ВозможностиПлатформы;
Перем КэшНоменклатуры;
Перем КэшХарактеристик;
Перем ИндексыПоддерживаются;

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ И ДЕТЕКТОР ВЕРСИИ
////////////////////////////////////////////////////////////////////////////////

&НаСервереБезКонтекста
Процедура ПриСозданииНаСервере() Экспорт
	
	ВозможностиПлатформы = ПолучитьВозможностиПлатформы();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВозможностиПлатформы() Экспорт
	
	Если ВозможностиПлатформы <> Неопределено Тогда
		Возврат ВозможностиПлатформы;
	КонецЕсли;
	
	Версия = ВерсияПлатформы();
	
	Возможности = Новый Структура();
	Возможности.Вставить("ИндексыТЗ", Версия >= "8.3.12");
	Возможности.Вставить("ПакетнаяЗапись", Версия >= "8.3.15");
	Возможности.Вставить("БыстрыйПарсерТД", Версия >= "8.3.24");
	Возможности.Вставить("ПараллельныеЗадания", Версия >= "8.5.1");
	Возможности.Вставить("Версия", Версия);
	
	ВозможностиПлатформы = Возможности;
	
	Возврат Возможности;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПОДГОТОВКА КЭШЕЙ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПодготовитьКэшиУНФ(МетаданныеКонфигурации) Экспорт
	
	Возможности = ПолучитьВозможностиПлатформы();
	ИндексыПоддерживаются = Возможности.ИндексыТЗ;
	
	// Кэш номенклатуры
	КэшНоменклатуры = Новый ТаблицаЗначений();
	КэшНоменклатуры.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КэшНоменклатуры.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка(50)"));
	КэшНоменклатуры.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка(100)"));
	КэшНоменклатуры.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка(255)"));
	КэшНоменклатуры.Колонки.Добавить("ИспользоватьХарактеристики", Новый ОписаниеТипов("Булево"));
	
	Если ИндексыПоддерживаются Тогда
		КэшНоменклатуры.Индексы.Добавить("КлючНом", Массив("Код", "Артикул"));
	КонецЕсли;
	
	// Заполнение кэша номенклатуры одним запросом
	ЗапросНом = Новый Запрос;
	ЗапросНом.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Код КАК Код,
		|	Номенклатура.Артикул КАК Артикул,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.ИспользоватьХарактеристики КАК ИспользоватьХарактеристики
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа";
	
	РезультатНом = ЗапросНом.Выполнить();
	Если РезультатНом <> Неопределено Тогда
		КэшНоменклатуры = РезультатНом.Выгрузить();
	КонецЕсли;
	
	// Кэш характеристик
	КэшХарактеристик = Новый ТаблицаЗначений();
	КэшХарактеристик.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КэшХарактеристик.Колонки.Добавить("Владелец", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КэшХарактеристик.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка(255)"));
	
	Если ИндексыПоддерживаются Тогда
		КэшХарактеристик.Индексы.Добавить("КлючХар", Массив("Владелец", "Наименование"));
	КонецЕсли;
	
	// Проверка существования справочника характеристик
	Если МетаданныеКонфигурации.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено Тогда
		ЗапросХар = Новый Запрос;
		ЗапросХар.Текст = 
			"ВЫБРАТЬ
			|	Характеристики.Ссылка КАК Ссылка,
			|	Характеристики.Владелец КАК Владелец,
			|	Характеристики.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ХарактеристикиНоменклатуры КАК Характеристики";
		
		РезультатХар = ЗапросХар.Выполнить();
		Если РезультатХар <> Неопределено Тогда
			КэшХарактеристик = РезультатХар.Выгрузить();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ПОИСКА В КЭШЕ
////////////////////////////////////////////////////////////////////////////////

&НаСервереБезКонтекста
Функция НайтиНоменклатуруПоКлючу(Знач Код, Знач Артикул) Экспорт
	
	Если КэшНоменклатуры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИндексыПоддерживаются Тогда
		КлючПоиска = Новый Структура("Код,Артикул", Код, Артикул);
		НайденнаяСтрока = КэшНоменклатуры.Найти(КлючПоиска, "КлючНом");
	Иначе
		// Линейный поиск для старых версий платформы
		НайденнаяСтрока = КэшНоменклатуры.Найти(Код, "Код");
		Если НайденнаяСтрока = Неопределено И ЗначениеЗаполнено(Артикул) Тогда
			НайденнаяСтрока = КэшНоменклатуры.Найти(Артикул, "Артикул");
		КонецЕсли;
	КонецЕсли;
	
	Если НайденнаяСтрока <> Неопределено Тогда
		Возврат НайденнаяСтрока.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиХарактеристикуПоКлючу(Знач Владелец, Знач Наименование) Экспорт
	
	Если КэшХарактеристик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИндексыПоддерживаются Тогда
		КлючПоиска = Новый Структура("Владелец,Наименование", Владелец, Наименование);
		НайденнаяСтрока = КэшХарактеристик.Найти(КлючПоиска, "КлючХар");
	Иначе
		// Линейный поиск
		Для Каждого СтрокаКэша Из КэшХарактеристик Цикл
			Если СтрокаКэша.Владелец = Владелец И СтрокаКэша.Наименование = Наименование Тогда
				НайденнаяСтрока = СтрокаКэша;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НайденнаяСтрока <> Неопределено Тогда
		Возврат НайденнаяСтрока.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВКэшНоменклатуры(Ссылка, Код, Артикул, Наименование, ИспользоватьХарактеристики) Экспорт
	
	Если КэшНоменклатуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = КэшНоменклатуры.Добавить();
	НоваяСтрока.Ссылка = Ссылка;
	НоваяСтрока.Код = Код;
	НоваяСтрока.Артикул = Артикул;
	НоваяСтрока.Наименование = Наименование;
	НоваяСтрока.ИспользоватьХарактеристики = ИспользоватьХарактеристики;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьВКэшХарактеристик(Ссылка, Владелец, Наименование) Экспорт
	
	Если КэшХарактеристик = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = КэшХарактеристик.Добавить();
	НоваяСтрока.Ссылка = Ссылка;
	НоваяСтрока.Владелец = Владелец;
	НоваяСтрока.Наименование = Наименование;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СОЗДАНИЕ И ОБНОВЛЕНИЕ ОБЪЕКТОВ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция СоздатьНоменклатуру(Знач Код, Знач Наименование, Знач Артикул, 
	Знач ИспользоватьХарактеристики = Ложь) Экспорт
	
	Попытка
		
		НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Наименование = Наименование;
		
		Если ЗначениеЗаполнено(Артикул) Тогда
			НовыйЭлемент.Артикул = Артикул;
		КонецЕсли;
		
		НовыйЭлемент.ИспользоватьХарактеристики = ИспользоватьХарактеристики;
		НовыйЭлемент.Записать();
		
		// Обновление кэша
		ДобавитьВКэшНоменклатуры(НовыйЭлемент.Ссылка, Код, Артикул, Наименование, ИспользоватьХарактеристики);
		
		Возврат НовыйЭлемент.Ссылка;
		
	Исключение
		ВызватьИсключение "Ошибка создания номенклатуры: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ОбновитьНоменклатуру(Ссылка, ДанныеДляОбновления) Экспорт
	
	Попытка
		
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Обновление реквизитов из структуры
		Для Каждого КлючИЗначение Из ДанныеДляОбновления Цикл
			Если Объект.Метаданные().Реквизиты.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
				Объект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Объект.Записать();
		Возврат Истина;
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СоздатьХарактеристику(Знач Владелец, Знач Наименование) Экспорт
	
	// Проверка существования справочника
	Если Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		НоваяХарактеристика.Владелец = Владелец;
		НоваяХарактеристика.Наименование = Наименование;
		НоваяХарактеристика.Записать();
		
		// Обновление кэша
		ДобавитьВКэшХарактеристик(НоваяХарактеристика.Ссылка, Владелец, Наименование);
		
		Возврат НоваяХарактеристика.Ссылка;
		
	Исключение
		ВызватьИсключение "Ошибка создания характеристики: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОСНОВНОЙ АЛГОРИТМ ЗАГРУЗКИ
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ЗагрузитьДанныеИзТабличногоДокумента(Знач ДвоичныеДанные, 
	Знач ТаблицаМаппинга, 
	Знач РежимЗагрузки = "СоздаватьЕслиНет",
	Знач РазмерПакета = 500) Экспорт
	
	Возможности = ПолучитьВозможностиПлатформы();
	
	// Отключение обновления интерфейса
	ОтключитьОбновлениеИнтерфейса(Истина);
	
	Попытка
		
		// Фаза 1: Чтение табличного документа
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ДвоичныеДанные);
		
		// Определение области данных
		Если ТабличныйДокумент.Макет.Область.КоличествоСтрок < 2 Тогда
			Возврат Новый Структура("Всего,Успешно,Ошибки", 0, 0, 0);
		КонецЕсли;
		
		// Получение заголовков из первой строки
		ОбластьЗаголовков = ТабличныйДокумент.Макет.Область(1, 1, ТабличныйДокумент.Макет.Ширина, 1);
		Заголовки = Новый Массив();
		Для к = 1 По ТабличныйДокумент.Макет.Ширина Цикл
			Заголовки.Добавить(ТабличныйДокумент.Макет.Область(1, к).Текст);
		КонецЦикла;
		
		// Импорт данных в таблицу значений
		ТЗДанные = ТабличныйДокумент.Макет.Область(2, 1, ТабличныйДокумент.Макет.Высота, ТабличныйДокумент.Макет.Ширина);
		ТаблицаДанных = Новый ТаблицаЗначений;
		
		// Создание колонок на основе маппинга
		Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
			Если СтрокаМаппинга.Режим <> "НеИспользовать" Тогда
				ТаблицаДанных.Колонки.Добавить(СтрокаМаппинга.ИмяРеквизита, Новый ОписаниеТипов("Строка"));
			КонецЕсли;
		КонецЦикла;
		
		// Заполнение данными
		Для НомерСтроки = 2 По ТабличныйДокумент.Макет.Высота Цикл
			НоваяСтрока = ТаблицаДанных.Добавить();
			Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
				Если СтрокаМаппинга.Режим <> "НеИспользовать" Тогда
					НомерКолонки = СтрокаМаппинга.НомерКолонки;
					Если НомерКолонки > 0 И НомерКолонки <= Заголовки.Количество() Тогда
						ЗначениеЯчейки = ТабличныйДокумент.Макет.Область(НомерСтроки, НомерКолонки).Текст;
						НоваяСтрока[СтрокаМаппинга.ИмяРеквизита] = ЗначениеЯчейки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ВсегоСтрок = ТаблицаДанных.Количество();
		Успешно = 0;
		Ошибки = 0;
		ЛогиОшибок = Новый ТаблицаЗначений;
		ЛогиОшибок.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		ЛогиОшибок.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
		ЛогиОшибок.Колонки.Добавить("Контекст", Новый ОписаниеТипов("Строка"));
		
		// Подготовка кэшей
		ПодготовитьКэшиУНФ(Метаданные);
		
		// Фаза 2: Пакетная обработка
		ТекущийПакет = 0;
		Для НомерСтроки = 0 По ВсегоСтрок - 1 Цикл
			
			// Начало новой транзакции для каждого пакета
			Если НомерСтроки % РазмерПакета = 0 Тогда
				НачатьТранзакцию();
				ТекущийПакет = НомерСтроки;
			КонецЕсли;
			
			Попытка
				
				СтрокаДанных = ТаблицаДанных[НомерСтроки];
				
				// Поиск ключевых полей
				Код = "";
				Артикул = "";
				Наименование = "";
				ХарактеристикаНаименование = "";
				
				Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
					Если СтрокаМаппинга.ЭтоКлючПоиска Тогда
						Если СтрокаМаппинга.ИмяРеквизита = "Код" Тогда
							Код = СтрокаДанных[СтрокаМаппинга.ИмяРеквизита];
						ИначеЕсли СтрокаМаппинга.ИмяРеквизита = "Артикул" Тогда
							Артикул = СтрокаДанных[СтрокаМаппинга.ИмяРеквизита];
						ИначеЕсли СтрокаМаппинга.ИмяРеквизита = "Наименование" Тогда
							Наименование = СтрокаДанных[СтрокаМаппинга.ИмяРеквизита];
						ИначеЕсли СтрокаМаппинга.ИмяРеквизита = "Характеристика.Наименование" Тогда
							ХарактеристикаНаименование = СтрокаДанных[СтрокаМаппинга.ИмяРеквизита];
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				// Поиск или создание номенклатуры
				СсылкаНаНоменклатуру = НайтиНоменклатуруПоКлючу(Код, Артикул);
				
				Если СсылкаНаНоменклатуру = Неопределено Тогда
					
					Если РежимЗагрузки = "СоздаватьЕслиНет" Тогда
						// Создание новой номенклатуры
						СсылкаНаНоменклатуру = СоздатьНоменклатуру(Код, Наименование, Артикул);
					Иначе
						// Пропуск строки
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				// Обработка характеристик
				Если ЗначениеЗаполнено(ХарактеристикаНаименование) Тогда
					
					СсылкаНаХарактеристику = НайтиХарактеристикуПоКлючу(СсылкаНаНоменклатуру, ХарактеристикаНаименование);
					
					Если СсылкаНаХарактеристику = Неопределено Тогда
						
						Если РежимЗагрузки = "СоздаватьЕслиНет" Тогда
							СсылкаНаХарактеристику = СоздатьХарактеристику(СсылкаНаНоменклатуру, ХарактеристикаНаименование);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				// Обновление реквизитов
				Если РежимЗагрузки <> "НеИспользовать" Тогда
					ДанныеДляОбновления = Новый Структура();
					Для Каждого СтрокаМаппинга Из ТаблицаМаппинга Цикл
						Если Не СтрокаМаппинга.ЭтоКлючПоиска И СтрокаМаппинга.Режим <> "НеИспользовать" Тогда
							Если СтрокаМаппинга.ЦелевойОбъект = "Номенклатура" Тогда
								ДанныеДляОбновления.Вставить(СтрокаМаппинга.ИмяРеквизита, СтрокаДанных[СтрокаМаппинга.ИмяРеквизита]);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					Если ДанныеДляОбновления.Количество() > 0 Тогда
						ОбновитьНоменклатуру(СсылкаНаНоменклатуру, ДанныеДляОбновления);
					КонецЕсли;
				КонецЕсли;
				
				Успешно = Успешно + 1;
				
				// Фиксация пакета
				Если (НомерСтроки - ТекущийПакет + 1) % РазмерПакета = 0 ИЛИ НомерСтроки = ВсегоСтрок - 1 Тогда
					ЗафиксироватьТранзакцию();
				КонецЕсли;
				
			Исключение
				
				// Откат транзакции при ошибке
				ОтменитьТранзакцию();
				
				// Логирование ошибки
				СтрокаЛога = ЛогиОшибок.Добавить();
				СтрокаЛога.НомерСтроки = НомерСтроки + 2; // +2 т.к. первая строка заголовки и нумерация с 1
				СтрокаЛога.ТекстОшибки = ОписаниеОшибки();
				СтрокаЛога.Контекст = "Код: " + Код + ", Артикул: " + Артикул;
				
				Ошибки = Ошибки + 1;
				
			КонецПопытки;
			
		КонецЦикла;
		
		Результат = Новый Структура();
		Результат.Вставить("Всего", ВсегоСтрок);
		Результат.Вставить("Успешно", Успешно);
		Результат.Вставить("Ошибки", Ошибки);
		Результат.Вставить("ЛогиОшибок", ЛогиОшибок);
		
		Возврат Результат;
		
	Исключение
		
		// Глобальный откат при критической ошибке
		Попытка
			ОтменитьТранзакцию();
		Исключение
		КонецПопытки;
		
		Возврат Неопределено;
		
	Наконец
		
		ОтключитьОбновлениеИнтерфейса(Ложь);
		
	КонецПопытки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// АВТОМАТИЧЕСКИЙ МАППИНГ
////////////////////////////////////////////////////////////////////////////////

&НаСервереБезКонтекста
Функция АвтоматическийМаппингЗаголовков(Заголовки, МетаданныеОбъекта) Экспорт
	
	ТаблицаМаппинга = Новый ТаблицаЗначений;
	ТаблицаМаппинга.Колонки.Добавить("НомерКолонки", Новый ОписаниеТипов("Число"));
	ТаблицаМаппинга.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	ТаблицаМаппинга.Колонки.Добавить("Режим", Новый ОписаниеТипов("Строка"));
	ТаблицаМаппинга.Колонки.Добавить("ЭтоКлючПоиска", Новый ОписаниеТипов("Булево"));
	ТаблицаМаппинга.Колонки.Добавить("ЦелевойОбъект", Новый ОписаниеТипов("Строка"));
	
	// Список соответствий для нечёткого поиска
	Соответствия = Новый Соответствие;
	Соответствия.Вставить("код", "Код");
	Соответствия.Вставить("code", "Код");
	Соответствия.Вставить("артикул", "Артикул");
	Соответствия.Вставить("sku", "Артикул");
	Соответствия.Вставить("наименование", "Наименование");
	Соответствия.Вставить("name", "Наименование");
	Соответствия.Вставить("название", "Наименование");
	Соответствия.Вставить("характеристика", "Характеристика.Наименование");
	Соответствия.Вставить("characteristic", "Характеристика.Наименование");
	
	Для НомерКолонки = 1 По Заголовки.Количество() Цикл
		
		Заголовок = НРег(СокрЛП(Заголовки[НомерКолонки - 1]));
		ИмяРеквизита = "";
		
		// Поиск точного соответствия
		Если Соответствия.Получить(Заголовок) <> Неопределено Тогда
			ИмяРеквизита = Соответствия.Получить(Заголовок);
		Иначе
			// Нечёткий поиск (>80% совпадения)
			Для Каждого КлючИЗначение Из Соответствия Цикл
				Если СтрНайти(Заголовок, КлючИЗначение.Ключ) > 0 Тогда
					ИмяРеквизита = КлючИЗначение.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
			
			СтрокаМаппинга = ТаблицаМаппинга.Добавить();
			СтрокаМаппинга.НомерКолонки = НомерКолонки;
			СтрокаМаппинга.ИмяРеквизита = ИмяРеквизита;
			СтрокаМаппинга.Режим = "СоздаватьЕслиНет";
			СтрокаМаппинга.ЭтоКлючПоиска = (ИмяРеквизита = "Код" ИЛИ ИмяРеквизита = "Артикул");
			СтрокаМаппинга.ЦелевойОбъект = ?(Встречаемость(ИмяРеквизита, ".") > 0, "Характеристика", "Номенклатура");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаМаппинга;
	
КонецФункции
